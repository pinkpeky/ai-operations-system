APP_ENV=production
PRODUCTION_CONFIG_STRICT=true
APP_NAME=AI Operations System
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=https://client.your-domain.cn

POSTGRES_PASSWORD=replace_with_real_secret_outside_git
REDIS_PASSWORD=replace_with_real_secret_outside_git
QDRANT_API_KEY=replace_with_real_secret_outside_git

LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=qwen2.5:14b
LLM_TIMEOUT_SECONDS=120

EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=1024
LOCAL_EMBEDDING_BASE_URL=http://host.docker.internal:11434
LOCAL_EMBEDDING_MODEL=bge-m3

RERANKER_PROVIDER=local
LOCAL_RERANKER_BASE_URL=http://host.docker.internal:8002
LOCAL_RERANKER_MODEL=bge-m3-embedding-reranker
LOCAL_RERANKER_ALLOW_FALLBACK=false
RERANKER_RUNTIME_PROVIDER=local
RERANKER_RUNTIME_ENGINE=ollama_embedding
RERANKER_RUNTIME_MODEL=bge-m3-embedding-reranker
RERANKER_RUNTIME_EMBEDDING_BASE_URL=http://host.docker.internal:11434
RERANKER_RUNTIME_EMBEDDING_MODEL=bge-m3
RERANKER_RUNTIME_TIMEOUT_SECONDS=60
RERANKER_RUNTIME_MAX_DOCUMENTS=64
RERANKER_RUNTIME_MAX_DOCUMENT_CHARS=4000
RERANKER_RUNTIME_EMBEDDING_CONCURRENCY=4

BROWSER_PROVIDER=remote
BROWSER_ALLOWED_DOMAINS=douyin.com,v.douyin.com,open.douyin.com
BROWSER_ALLOW_EXTERNAL_DOMAINS=false
BROWSER_WORKER_AUTH_ENABLED=true
BROWSER_WORKER_AUTH_STRICT=true
BROWSER_WORKER_SHARED_SECRET=replace_with_real_worker_secret_outside_git
BROWSER_WORKER_SECRET=replace_with_real_worker_secret_outside_git
BROWSER_WORKER_DEFAULT_URL=http://browser-worker:9100

OPENCLAW_ENABLED=true
OPENCLAW_PROVIDER=worker_runtime
WORKER_CLIENT_OPENCLAW_ENABLED=true
WORKER_CLIENT_OPENCLAW_PROVIDER=openclaw_http
WORKER_CLIENT_OPENCLAW_BASE_URL=http://127.0.0.1:17900
WORKER_CLIENT_OPENCLAW_API_KEY=replace_with_real_openclaw_adapter_api_key_outside_git
WORKER_CLIENT_OPENCLAW_TIMEOUT_SECONDS=60
WORKER_CLIENT_OPENCLAW_HEALTH_PATH=/openclaw/health
WORKER_CLIENT_OPENCLAW_CAPABILITIES_PATH=/openclaw/capabilities
WORKER_CLIENT_OPENCLAW_ACTION_PATH=/openclaw/actions

COMFYUI_RUNTIME_PROVIDER=guarded
COMFYUI_RUNTIME_ENABLED=true
COMFYUI_RUNTIME_BASE_URL=http://host.docker.internal:8188
COMFYUI_RUNTIME_ALLOW_NETWORK=true
COMFYUI_RUNTIME_ALLOWED_HOSTS=host.docker.internal,127.0.0.1,localhost
COMFYUI_RUNTIME_HEALTH_PATH=/system_stats
COMFYUI_RUNTIME_ALLOWED_HEALTH_PATHS=/system_stats
COMFYUI_RUNTIME_PROMPT_SUBMISSION_ENABLED=true
COMFYUI_RUNTIME_ALLOWED_EXECUTION_PATHS=/prompt,/history,/queue

DIGITAL_HUMAN_PROVIDER=local_musetalk_liveportrait
DIGITAL_HUMAN_ENABLED=true
DIGITAL_HUMAN_ALLOW_EXTERNAL_API=false
