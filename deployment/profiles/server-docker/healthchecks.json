    { "name": "task-runs", "url": "http://localhost:8000/api/v1/task-runs", "required": false, "headers": { "X-Workspace-Id": "demo-workspace", "X-User-Id": "demo-user" } },
    { "name": "output-artifacts", "url": "http://localhost:8000/api/v1/output-artifacts", "required": false, "headers": { "X-Workspace-Id": "demo-workspace", "X-User-Id": "demo-user" } }
