APP_NAME=AI Operations System
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim

POSTGRES_HOST=postgres
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change_me
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

REDIS_HOST=redis
REDIS_IMAGE=public.ecr.aws/docker/library/redis:7-alpine
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me
REDIS_QUEUE_NAME=aiops:tasks

QDRANT_HOST=qdrant
QDRANT_IMAGE=ghcr.io/qdrant/qdrant/qdrant:v1.16.3
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change_me

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=5
SCHEDULER_BATCH_SIZE=20
SCHEDULER_RUNNING_TIMEOUT_SECONDS=300
TASK_EXECUTOR_ENABLED=true
TASK_EXECUTOR_DEQUEUE_TIMEOUT_SECONDS=5

LLM_PROVIDER=mock
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=mistral
SERVER_LLM_BASE_URL=http://host.docker.internal:8001/v1
SERVER_LLM_MODEL=llama-70b
LLM_TIMEOUT_SECONDS=120

EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=384
LOCAL_EMBEDDING_BASE_URL=http://host.docker.internal:11434
LOCAL_EMBEDDING_MODEL=bge-m3
QDRANT_COLLECTION_NAME=ai_knowledge_base

RERANKER_PROVIDER=mock
LOCAL_RERANKER_BASE_URL=http://host.docker.internal:11434
LOCAL_RERANKER_MODEL=local-reranker-model
RERANK_TOP_N=5

DEFAULT_SEARCH_MODE=hybrid
DENSE_TOP_K=20
KEYWORD_TOP_K=20
FINAL_TOP_K=5

MAX_UPLOAD_FILE_SIZE_MB=20
UPLOAD_TEMP_DIR=/tmp/aiops_uploads
ALLOWED_FILE_TYPES=pdf,docx,txt,md,csv
