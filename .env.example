APP_NAME=AI Operations System
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5180,http://127.0.0.1:5180,tauri://localhost
PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim

POSTGRES_HOST=postgres
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change_me
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

REDIS_HOST=redis
REDIS_IMAGE=public.ecr.aws/docker/library/redis:7-alpine
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me
REDIS_QUEUE_NAME=aiops:tasks

QDRANT_HOST=qdrant
QDRANT_IMAGE=ghcr.io/qdrant/qdrant/qdrant:v1.16.3
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change_me

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=5
SCHEDULER_BATCH_SIZE=20
SCHEDULER_RUNNING_TIMEOUT_SECONDS=300
TASK_EXECUTOR_ENABLED=true
TASK_EXECUTOR_DEQUEUE_TIMEOUT_SECONDS=5
TASK_ORCHESTRATOR_ENABLED=true
TASK_ORCHESTRATOR_POLL_INTERVAL_SECONDS=2
TASK_ORCHESTRATOR_BATCH_SIZE=5
TASK_RUN_DEFAULT_MAX_RETRIES=3
TASK_SCHEDULER_NAME=api-in-process-task-scheduler
TASK_LEASE_SECONDS=120
TASK_STUCK_TIMEOUT_SECONDS=300
TASK_SCHEDULER_RECOVERY_INTERVAL_SECONDS=10

LLM_PROVIDER=mock
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=mistral
SERVER_LLM_BASE_URL=http://host.docker.internal:8001/v1
SERVER_LLM_MODEL=llama-70b
LLM_TIMEOUT_SECONDS=120

EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=384
LOCAL_EMBEDDING_BASE_URL=http://host.docker.internal:11434
LOCAL_EMBEDDING_MODEL=bge-m3
QDRANT_COLLECTION_NAME=ai_knowledge_base

RERANKER_PROVIDER=mock
LOCAL_RERANKER_BASE_URL=http://host.docker.internal:11434
LOCAL_RERANKER_MODEL=local-reranker-model
RERANK_TOP_N=5

DEFAULT_SEARCH_MODE=hybrid
DENSE_TOP_K=20
KEYWORD_TOP_K=20
FINAL_TOP_K=5

MAX_UPLOAD_FILE_SIZE_MB=20
UPLOAD_TEMP_DIR=/tmp/aiops_uploads
ALLOWED_FILE_TYPES=pdf,docx,txt,md,csv

BROWSER_PROVIDER=mock
BROWSER_TIMEOUT_SECONDS=30
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720
BROWSER_SCREENSHOT_DIR=screenshots
BROWSER_RUNTIME_SCREENSHOT_DIR=storage/browser_screenshots
BROWSER_RUNTIME_SNAPSHOT_DIR=storage/browser_runtime_snapshots
OUTPUT_ARTIFACT_DIR=storage/output_artifacts
OUTPUT_PACKAGE_DIR=storage/output_packages
OUTPUT_EXPORT_DIR=storage/output_exports
BROWSER_PROFILE_ROOT=worker/profiles
BROWSER_PROFILE_LOCK_TIMEOUT_SECONDS=1800
BROWSER_PROFILE_BACKUP_ENABLED=true
BROWSER_PROFILE_MAX_BACKUPS=3
BROWSER_PROFILE_UNUSED_DAYS=30
BROWSER_PROFILE_BACKUP_ROOT=worker/profile_backups
BROWSER_HUMAN_CONTROL_TIMEOUT_SECONDS=900
BROWSER_UI_ACCESS_TIMEOUT_SECONDS=900
BROWSER_WORKER_AUTH_ENABLED=true
BROWSER_WORKER_AUTH_STRICT=false
BROWSER_ALLOWED_DOMAINS=example.com,localhost,127.0.0.1
BROWSER_BLOCKED_DOMAINS=
BROWSER_ALLOW_EXTERNAL_DOMAINS=false
BROWSER_WORKER_DEFAULT_TIMEOUT_SECONDS=30
BROWSER_WORKER_RETRY_COUNT=2
BROWSER_WORKER_DEFAULT_URL=http://browser-worker:9100
BROWSER_WORKER_HEARTBEAT_TIMEOUT_SECONDS=60
BROWSER_WORKER_HEALTH_CHECK_INTERVAL_SECONDS=30
BROWSER_SESSION_TIMEOUT_SECONDS=1800
BROWSER_SESSION_CLEANUP_INTERVAL_SECONDS=300
BROWSER_ACTION_TIMEOUT_SECONDS=60
BROWSER_ACTION_RETRY_COUNT=2
BROWSER_ACTION_RETRY_BACKOFF_SECONDS=2
SCREENSHOT_RETENTION_DAYS=7
OPENCLAW_PROVIDER=mock
OPENCLAW_ENABLED=true
OPENCLAW_ACTION_TIMEOUT_SECONDS=60
BROWSER_WORKER_PORT=9100

COMFYUI_RUNTIME_PROVIDER=disabled
COMFYUI_RUNTIME_ENABLED=false
COMFYUI_RUNTIME_BASE_URL=http://127.0.0.1:8188
COMFYUI_RUNTIME_TIMEOUT_SECONDS=30
COMFYUI_RUNTIME_ALLOW_NETWORK=false
COMFYUI_RUNTIME_ALLOWED_HOSTS=127.0.0.1,localhost
COMFYUI_RUNTIME_READ_ONLY_PROBE_ENABLED=false
COMFYUI_RUNTIME_HEALTH_PATH=/system_stats
COMFYUI_RUNTIME_ALLOWED_HEALTH_PATHS=/system_stats
COMFYUI_RUNTIME_PROMPT_SUBMISSION_ENABLED=false
COMFYUI_RUNTIME_ALLOWED_EXECUTION_PATHS=/prompt,/history,/queue
COMFYUI_VIDEO_MAX_CONCURRENT_JOBS=1
COMFYUI_VIDEO_QUEUE_PENDING_LIMIT=2
COMFYUI_VIDEO_MIN_FREE_VRAM_MB=2048
COMFYUI_VIDEO_DEFAULT_VRAM_ESTIMATE_MB=8192
COMFYUI_VIDEO_GPU_ENDPOINTS=

WORKER_HOST=0.0.0.0
WORKER_PORT=9100
WORKER_TIMEOUT_SECONDS=30
WORKER_HEADLESS=true
WORKER_BROWSER_TYPE=chromium
WORKER_SCREENSHOT_DIR=worker/screenshots
WORKER_PROFILE_DIR=worker/profiles
WORKER_VIEWPORT_WIDTH=1280
WORKER_VIEWPORT_HEIGHT=720
